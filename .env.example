# Đường dẫn API phía trình duyệt — tương đối, cùng origin với trang web
# (xem next.config.js rewrites() + src/services/http.client.ts).
NEXT_PUBLIC_API_URL=/api

# Chỉ dùng phía server — nơi Next.js server trực tiếp gọi đến Backend Express.
BACKEND_INTERNAL_URL=http://127.0.0.1:5000

# Tên miền công khai của kho ảnh (Cloudflare R2). Cần cho next/image; mặc định https://media.ducmanh.store
# NEXT_PUBLIC_MEDIA_URL=https://media.ducmanh.store
